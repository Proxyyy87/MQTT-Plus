{
  "common": {
    "name": "mqtt-plus",
    "version": "1.6.1",
    "news": {
      "1.6.1": {
        "en": "Per-mapping sync mode: 'standard', 'pass every update' (same value with newer timestamp is mirrored, for rarely changing sensors) or 'force as before 1.6.0'; mapping settings now shown as accordion with two short rows per entry",
        "de": "Sync-Modus pro Mapping: 'Standard', 'Jede Meldung weiterreichen' (gleicher Wert mit neuerem Zeitstempel wird gespiegelt, für selten wechselnde Sensoren) oder 'Force wie vor 1.6.0'; Mapping-Einstellungen jetzt als aufklappbare Liste mit zwei kurzen Zeilen pro Eintrag"
      }
    },
    "titleLang": {
      "en": "MQTT Plus Bridge",
      "de": "MQTT Plus-Brücke"
    },
    "desc": {
      "en": "Bridge between ioBroker states and MQTT with JSON export and Remote Sync",
      "de": "Brücke zwischen ioBroker-Zuständen und MQTT mit JSON-Export und Remote-Sync"
    },
    "authors": [
      "proxy <zumloeschen@ich.ms>"
    ],
    "keywords": [
      "mqtt",
      "bridge",
      "export",
      "sync"
    ],
    "licenseInformation": {
      "type": "free",
      "license": "MIT"
    },
    "platform": "Javascript/Node.js",
    "icon": "mqtt-plus.png",
    "enabled": true,
    "loglevel": "debug",
    "mode": "daemon",
    "type": "iot-systems",
    "compact": true,
    "connectionType": "local",
    "dataSource": "poll",
    "messagebox": true,
    "adminUI": {
      "config": "json"
    },
    "dependencies": [
      {
        "js-controller": ">=6.0.11"
      }
    ],
    "tier": 3,
    "extIcon": "https://raw.githubusercontent.com/Proxyyy87/ioBroker.mqtt-plus/main/admin/mqtt-plus.png",
    "localLinks": {
      "_default": "http://%ip%:%native_serverPort%"
    }
  },
  "native": {
    "targetBasePath": "mqtt.0.",
    "updateIntervalSec": 30,
    "logTransfers": true,
    "mappings": [],
    "syncUrl": "",
    "syncIntervalMin": 60,
    "serverPort": 8095,
    "dashboardUser": "admin",
    "dashboardPassword": "",
    "dashboardTlsCert": "",
    "dashboardTlsKey": "",
    "syncCaCert": "",
    "forceSyncIntervalMin": 5,
    "bindHost": "0.0.0.0",
    "staleAfterMin": 1440,
    "remoteSyncSkipStale": false
  },
  "encryptedNative": [
    "dashboardPassword",
    "dashboardTlsKey"
  ],
  "protectedNative": [
    "dashboardPassword",
    "dashboardTlsKey"
  ],
  "objects": [],
  "instanceObjects": [
    {
      "_id": "watchdog",
      "type": "state",
      "common": {
        "name": "MQTT Bridge Watchdog",
        "type": "string",
        "role": "text",
        "read": true,
        "write": false
      },
      "native": {}
    },
    {
      "_id": "info.dashboardUrl",
      "type": "state",
      "common": {
        "name": "Dashboard URL",
        "type": "string",
        "role": "url",
        "read": true,
        "write": false
      },
      "native": {}
    },
    {
      "_id": "info.lastSyncStatus",
      "type": "state",
      "common": {
        "name": "Letzter Sync Status",
        "type": "string",
        "role": "text",
        "read": true,
        "write": false
      },
      "native": {}
    },
    {
      "_id": "info.status",
      "type": "state",
      "common": {
        "name": "Status",
        "type": "string",
        "role": "text",
        "read": true,
        "write": false
      },
      "native": {}
    },
    {
      "_id": "info.lastCycle",
      "type": "state",
      "common": {
        "name": "Letzter Sync-Zyklus",
        "type": "number",
        "role": "value.time",
        "read": true,
        "write": false
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "name": "Connected",
        "type": "boolean",
        "role": "indicator.connected",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.version",
      "type": "state",
      "common": {
        "name": "Adapter-Version",
        "type": "string",
        "role": "info.version",
        "read": true,
        "write": false
      },
      "native": {}
    },
    {
      "_id": "info.authLockouts",
      "type": "state",
      "common": {
        "name": "Login-Sperrliste (intern)",
        "type": "string",
        "role": "json",
        "read": true,
        "write": false,
        "def": "{}"
      },
      "native": {}
    }
  ]
}
